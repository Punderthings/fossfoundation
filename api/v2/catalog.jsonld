    {
      "@id": "https://fossfoundation.info/api/v2/catalog.jsonld#sponsors",
      "@type": "dcat:Dataset",
      "dct:identifier": "sponsors",
      "dct:title": "Sponsors",
      "dct:description": "Key sponsors that fund several foundations: the domains that join them to sponsor data, and lookup identifiers such as LEI, SEC CIK, and Wikidata",
      "dcat:landingPage": {
        "@id": "https://fossfoundation.info/sponsors"
      },
      "dct:publisher": {
        "@id": "https://fossfoundation.info"
      },
      "dct:accrualPeriodicity": {
        "@id": "http://publications.europa.eu/resource/authority/frequency/IRREG"
      },
      "dct:conformsTo": [
        {
          "@id": "https://github.com/Punderthings/fossfoundation/blob/main/_data/sponsors-schema.json"
        }
      ],
      "dct:license": {
        "@id": "https://spdx.org/licenses/CC0-1.0"
      },
      "dct:provenance": {
        "@type": "dct:ProvenanceStatement",
        "rdfs:label": "Models are written by hand from each organization's own sponsorship pages. Sponsor lists are scanned by our tools. Sponsor records are looked up in authoritative registries such as GLEIF and SEC EDGAR. The dates and method of each scan: when each sponsor list was first seen and last confirmed, and where each past list came from, such as an Internet Archive capture. Models link the pages they model and the date their levels took effect. Sponsor records list a source and date for each lookup value."
      },
      "dcat:distribution": [
        {
          "@type": "dcat:Distribution",
          "dct:title": "_sponsors/",
          "dcat:accessURL": {
            "@id": "https://github.com/Punderthings/fossfoundation/tree/main/_sponsors"
          },
