    {
      "@id": "https://fossfoundation.info/api/v2/catalog.jsonld#foundations",
      "@type": "dcat:Dataset",
      "dct:identifier": "foundations",
      "dct:title": "Foundations",
      "dct:description": "One record per non-profit FOSS organization: legal identity, governance, policies, funding",
      "dcat:landingPage": {
        "@id": "https://fossfoundation.info/fdnmodel"
      },
      "dct:publisher": {
        "@id": "https://fossfoundation.info"
      },
      "dct:accrualPeriodicity": {
        "@id": "http://publications.europa.eu/resource/authority/frequency/IRREG"
      },
      "dct:conformsTo": [
        {
          "@id": "https://github.com/Punderthings/fossfoundation/blob/main/_data/foundations-schema.json"
        }
      ],
      "dct:license": {
        "@id": "https://spdx.org/licenses/Apache-2.0"
      },
      "dct:provenance": {
        "@type": "dct:ProvenanceStatement",
        "rdfs:label": "A maintainer checks each change against the organization's own site, which the pull request links. Descriptive text also follows the officers get a say rule. No per-field sources or check dates. The pull request, with its links, and git history are the record: git log _foundations/<identifier>.md lists every change to one record."
      },
      "dcat:distribution": [
        {
          "@type": "dcat:Distribution",
