    {
      "@id": "https://fossfoundation.info/api/v2/catalog.jsonld#crosswalk",
      "@type": "dcat:Dataset",
      "dct:identifier": "crosswalk",
      "dct:title": "Platform crosswalk",
      "dct:description": "Which code host and package registry accounts belong to a foundation, with evidence",
      "dcat:landingPage": {
        "@id": "https://fossfoundation.info/crosswalk"
      },
      "dct:publisher": {
        "@id": "https://fossfoundation.info"
      },
      "dct:accrualPeriodicity": {
        "@id": "http://publications.europa.eu/resource/authority/frequency/IRREG"
      },
      "dct:conformsTo": [
        {
          "@id": "https://github.com/Punderthings/fossfoundation/blob/main/_data/crosswalk-schema.json"
        }
      ],
      "dct:provenance": {
        "@type": "dct:ProvenanceStatement",
        "rdfs:label": "Every link needs evidence that anyone can check again, its confidence is computed from that evidence, only listed attestors can confirm a link out of band, and a maintainer reviews every change. Evidence items on every link: its type, a source URL, the date observed, and who recorded it, plus records of attestors and of the people who confirmed links. Once a reviewer has checked a link, it also records who and when; a link without that has not yet been checked. See crosswalk accuracy."
      },
      "dcat:distribution": [
        {
          "@type": "dcat:Distribution",
          "dct:title": "_data/crosswalk/",
          "dcat:accessURL": {
